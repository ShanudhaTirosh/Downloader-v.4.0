[Unit]
Description=Gunicorn instance to serve Social Media Downloader Pro
After=network.target

[Service]
# Adjust these paths to match your VPS setup
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/downloader
Environment="PATH=/home/ubuntu/downloader/venv/bin"
EnvironmentFile=/home/ubuntu/downloader/.env

ExecStart=/home/ubuntu/downloader/venv/bin/gunicorn \
    --workers 4 \
    --worker-class uvicorn.workers.UvicornWorker \
    --bind 0.0.0.0:9000 \
    main:app

[Install]
WantedBy=multi-user.target
