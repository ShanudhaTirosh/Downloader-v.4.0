[Unit]
Description=Gunicorn instance to serve Social Media Downloader Pro
After=network.target

[Service]
# Corrected paths to match your VPS directory structure
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/Downloader-v.4.0
Environment="PATH=/home/ubuntu/Downloader-v.4.0/venv/bin"
EnvironmentFile=/home/ubuntu/Downloader-v.4.0/.env

ExecStart=/home/ubuntu/Downloader-v.4.0/venv/bin/gunicorn \
    --workers 4 \
    --worker-class uvicorn.workers.UvicornWorker \
    --bind 0.0.0.0:9000 \
    main:app

[Install]
WantedBy=multi-user.target
